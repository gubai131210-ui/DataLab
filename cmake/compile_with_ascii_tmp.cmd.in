@echo off
rem MinGW cc1plus can exit silently when TEMP/TMP contains non-ASCII path segments.
rem Generated by CMake; do not edit the build-tree copy by hand.
set "DATALAB_COMPILER_TMP=@CMAKE_BINARY_DIR@/.compiler_tmp"
if not exist "%DATALAB_COMPILER_TMP%" mkdir "%DATALAB_COMPILER_TMP%"
set "TMP=%DATALAB_COMPILER_TMP%"
set "TEMP=%DATALAB_COMPILER_TMP%"
%*
